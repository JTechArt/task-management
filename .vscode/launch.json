{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "TaskManager: Debug Local App",
            "type": "java",
            "request": "attach",
            "hostName": "localhost",
            "port": 5005,
            "preLaunchTask": "TaskManager: Debug Local Desktop App",
            "postDebugTask": "TaskManager: Stop Debug Gradle"
        },
        {
            "name": "TaskManager: Run Local App",
            "type": "node-terminal",
            "request": "launch",
            "command": "cd \"${workspaceFolder}/taskmanager\" && ./scripts/run-local.sh"
        },
        {
            "name": "TaskManager: Run App Without DB Bootstrap",
            "type": "node-terminal",
            "request": "launch",
            "command": "cd \"${workspaceFolder}/taskmanager\" && JAVA_HOME=\"$(./scripts/resolve-java21.sh)\" PATH=\"$(./scripts/resolve-java21.sh)/bin:${PATH}\" ./gradlew --console=plain :desktop-app:runDesktopAppNoDb"
        }
    ]
}
